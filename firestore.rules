rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: a user must be signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: the signed-in user owns the document by UID.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: only allow known profile fields and reasonable sizes.
    function validProfile() {
      let data = request.resource.data;
      return data.id is string &&
             data.username is string &&
             data.username.size() > 0 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() <= 80 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('followerCount' in data) || data.followerCount is int) &&
             (!('followingCount' in data) || data.followingCount is int);
    }

    // Default deny for anything not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: readable by any signed-in user; only the owner writes.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);
    }

    // Personality test answers are private to the user.
    match /personality_tests/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
