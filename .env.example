# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_DATABASE_URL=your_database_url
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIRESTORE_DATABASE_ID=your_firestore_database_id

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# API Server Security (api-server)
# Comma-separated list of origins allowed to call the API (no trailing slash).
# If unset, all origins are allowed (development only; set this in production).
CORS_ORIGIN=http://localhost:3000,https://your-app.example.com
# Supabase backend for analytics events (optional; falls back to file/memory).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANALYTICS_TABLE=analytics_events
SUPABASE_REQUEST_TIMEOUT_MS=2500

# Firebase project used to verify client ID tokens on the API.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SOCIAL_FEATURES=true

# Performance
VITE_CACHE_DURATION=300000
VITE_PREFETCH_DELAY=1000
